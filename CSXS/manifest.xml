<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0"
                   ExtensionBundleId="com.koseimarker.extension"
                   ExtensionBundleVersion="1.1.0"
                   ExtensionBundleName="校正マーカー">
  <ExtensionList>
    <Extension Id="com.koseimarker.panel" Version="1.0.0"/>
    <!-- 開発・調査専用の診断パネル（読み取りのみ。本番パネルとは独立） -->
    <Extension Id="com.koseimarker.textdiag" Version="1.0.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[14.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="7.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.koseimarker.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./js/hostscript.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>チェック｜校正マーカー</Menu>
          <Geometry>
            <Size>
              <Height>460</Height>
              <Width>320</Width>
            </Size>
            <MinSize>
              <Height>360</Height>
              <Width>260</Width>
            </MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>

    <!-- ===================== 診断パネル（開発・調査専用） =====================
         シーケンスを読み取って診断JSONを書き出すだけのパネル。
         本番パネル（com.koseimarker.panel）の定義には一切影響しない。
         不要になったらこの Extension ブロックと ExtensionList の1行を消せば元に戻る。 -->
    <Extension Id="com.koseimarker.textdiag">
      <DispatchInfo>
        <Resources>
          <MainPath>./diag/textdiag.html</MainPath>
          <ScriptPath>./diag/textdiag.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>調査｜テキスト取得診断</Menu>
          <Geometry>
            <Size>
              <Height>640</Height>
              <Width>380</Width>
            </Size>
            <MinSize>
              <Height>400</Height>
              <Width>300</Width>
            </MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
