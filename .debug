<ExtensionList>
  <Extension Id="com.koseimarker.panel">
    <HostList>
      <Host Name="PPRO" Port="7778"/>
    </HostList>
  </Extension>
  <!-- 診断パネル（開発・調査専用）。Chrome で localhost:7779 を開くと DevTools が使える -->
